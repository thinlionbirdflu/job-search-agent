# Copy to .env only if you want to override defaults. Shell variables take precedence.
# JOB_AGENT_DB=jobs.sqlite3
# JOB_AGENT_CONFIG=settings.live.json
# JOB_AGENT_RESUME=resume.txt

# Required for cross-employer searches with settings.adzuna.json.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# Required only with the run --ai flag. Choose a model enabled for your API project.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1

# Required with run --ai --ai-provider anthropic. Keys come from the Claude Console.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
